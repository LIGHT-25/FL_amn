# FlowForge — copy to .env and fill values
NODE_ENV=development
# Host port 5433 maps to container 5432 (see docker-compose.yml).
DATABASE_URL=postgresql://flowforge:flowforge@localhost:5433/flowforge
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
EXECUTION_MODE=inprocess
VITE_API_URL=http://localhost:3001

# Content Pipeline — Gemini captions (required for this template)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Set true only for offline unit tests (skips Sheets backends).
SHEETS_MOCK=false

# When true (default), Tavily / Unsplash / Facebook / Slack / Google Sheets fail instead of silent mocks.
CONNECTOR_STRICT=true

# --- Google Sheets (real) ---
# 1) Create a Google Cloud service account with Sheets API enabled
# 2) Download the JSON key and paste it as one line below (or use EMAIL + PRIVATE_KEY)
# 3) Create a spreadsheet with tabs Topics + Drafts (headers: Topic, Keywords, Status, …)
# 4) Share the spreadsheet with the service-account email as Editor
# 5) Paste the spreadsheet ID from the URL (docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=
# Preferred: path to the downloaded service-account JSON (gitignored as google-sa.json)
GOOGLE_SERVICE_ACCOUNT_FILE=../../google-sa.json
# Or paste the JSON on one line:
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or split fields:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Local Postgres calendar (content-calendar) remains available when the Spreadsheet ID
# is a short key like content-calendar — useful without Google credentials.

# Required for an all-green Content Pipeline Test run (then Host on schedule):
TAVILY_API_KEY=
# Stock images — Unsplash is the Content Pipeline default (https://unsplash.com/developers).
UNSPLASH_ACCESS_KEY=
# Optional alternate provider for the image step:
PEXELS_API_KEY=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=
SLACK_WEBHOOK_URL=

# Keep the API process running (pnpm / Docker / pm2) so the in-process schedule runner can fire hosted workflows.
