# Copy to .env.prod for docker compose -f docker-compose.prod.yml
NODE_ENV=production
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=flowforge
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DEMO_MODE=true
DEMO_PUBLISH_ENABLED=false
DEMO_MAX_RUNS_PER_DAY=20
DEMO_MAX_WORKFLOWS=15
DEMO_MAX_ACTIVE_SCHEDULES=2
DEMO_MIN_SCHEDULE_MINUTES=15
DEMO_USER_PASSWORD=demo-flowforge
RUN_SEED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
TAVILY_API_KEY=
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=
SLACK_WEBHOOK_URL=
CONNECTOR_STRICT=true
SHEETS_MOCK=false
