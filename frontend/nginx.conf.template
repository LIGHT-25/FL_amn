server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;
  }

  # Same-origin /api so auth cookies work across split Render services.
  # API_UPSTREAM examples:
  #   Render:  http://flowforge-api:10000
  #   Compose: http://api:3001
  location /api/ {
    proxy_pass ${API_UPSTREAM}/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Cookie $http_cookie;
  }

  location /health {
    proxy_pass ${API_UPSTREAM}/health;
    proxy_set_header Host $host;
  }

  location /ready {
    proxy_pass ${API_UPSTREAM}/ready;
    proxy_set_header Host $host;
  }
}
