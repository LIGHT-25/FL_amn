server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Defer upstream DNS so nginx can start while the API is cold or redeploying.
  resolver 8.8.8.8 valid=30s ipv6=off;
  set $api_upstream "${API_UPSTREAM}";

  location / {
    try_files $uri $uri/ /index.html;
  }

  # Same-origin /api so auth cookies stay on the web host.
  # API_UPSTREAM must be an absolute origin, e.g. https://flowforge-api-xxxx.onrender.com
  # Important: no URI on proxy_pass when using a variable — keep the full /api/... path.
  location /api/ {
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Cookie $http_cookie;
  }

  location = /health {
    proxy_pass $api_upstream/health;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
  }

  location = /ready {
    proxy_pass $api_upstream/ready;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
  }
}
